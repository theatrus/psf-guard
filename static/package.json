{
  "name": "psf-guard-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "npm run build && cp -r dist/* ../dist/static/",
    "lint": "eslint .",
    "test": "vitest run",
    "test:release": "node --test ../scripts/check-release-version.test.mjs ../scripts/release-feeds.test.mjs",
    "test:scripts": "node --test ../scripts/e2e-local.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "tauri:dev": "cd .. && cargo tauri dev",
    "tauri:build": "cd .. && cargo tauri build"
  },
  "dependencies": {
    "@seiza/astro-overlay": "^0.6.0",
    "@tanstack/react-query": "^5.104.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "axios": "^1.20.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-intersection-observer": "^11.0.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
